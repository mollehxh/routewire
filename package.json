{
  "name": "routewire",
  "version": "0.1.3",
  "description": "Bridge a live local Codex tool surface into ChatGPT over MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mollehxh/routewire.git"
  },
  "bugs": {
    "url": "https://github.com/mollehxh/routewire/issues"
  },
  "homepage": "https://github.com/mollehxh/routewire#readme",
  "keywords": [
    "mcp",
    "codex",
    "chatgpt",
    "openai",
    "cli",
    "developer-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHATGPT_PROJECT_INSTRUCTIONS.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "bin": {
    "routewire": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "adm-zip": "^0.6.1",
    "cross-spawn": "^7.0.6",
    "ink": "7.1.1",
    "react": "^19.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
